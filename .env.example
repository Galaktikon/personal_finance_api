# Copy to .env for local development. Use separate credentials for tests and deployment.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://finance:finance_local_only@localhost:5432/finance
LOG_LEVEL=INFO

# Optional: independent PostgreSQL database for integration tests.
# TEST_DATABASE_URL=postgresql+psycopg://finance:finance_local_only@localhost:5432/finance_test

# Phase 3 will add verified Neon Auth settings after the integration gate.
# A Neon DATABASE_URL must use postgresql+psycopg:// with TLS, for example sslmode=require.
